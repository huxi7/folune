# [INPUT]: 依赖本地 Supabase 项目配置与 10000 起步的端口约定
# [OUTPUT]: 提供无真实密钥的 app/api/chat 本地变量总览与根 Compose 覆盖模板
# [POS]: 仓库根本地环境契约；服务默认分别读取 app/.env.local、api/.env 与 chat/.env
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

# Shared
SYSTEM_NAME=SuperNote API
NODE_ENV=development

# app (host Bun/Vite)
# VITE_API_URL 保留给本地工具；业务请求统一读取 VITE_API_BASE_URL。
VITE_API_URL=http://localhost:10001
VITE_API_BASE_URL=http://localhost:10001
VITE_CHAT_BASE_URL=http://localhost:10002
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# api (Docker)
API_PORT=10001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
CORS_ORIGINS=http://localhost:10000,http://127.0.0.1:10000

# chat (Docker, server only)
CHAT_PORT=10002
CHAT_SYSTEM_NAME=SuperNote Chat
ALLOWED_ORIGINS=http://localhost:10000,http://127.0.0.1:10000
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEFAULT_MODEL=deepseek/deepseek-v4-flash
MAX_STEPS=50
MAX_OUTPUT_TOKENS=393216
