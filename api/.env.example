# [INPUT]: 依赖 Supabase 项目与 NOWPayments 商户的独立环境配置
# [OUTPUT]: 提供不含真实凭据的 API 本地环境模板
# [POS]: api 私有 .env 的配置说明；账本与开售独立控制，默认关闭
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
PORT=10001
NODE_ENV=development
SYSTEM_NAME=Folune API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
CORS_ORIGINS=http://localhost:10000,http://127.0.0.1:10000
AI_DAILY_TOKEN_LIMIT=100000
AI_STARTER_DAILY_TOKEN_LIMIT=2000000
AI_PRO_DAILY_TOKEN_LIMIT=10000000
AI_STUDIO_DAILY_TOKEN_LIMIT=50000000

# NOWPayments：沙箱/正式密钥必须与环境匹配；仅服务端读取，禁止 VITE_ 前缀。
# IPN Secret 在商户后台生成，不是 API Key；填入后仍须验证真实回调。
NOWPAYMENTS_ENV=production
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# 商户提供：NOWPayments 独立登录信息，用于自动补查遗漏付款。
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=

# 以下由开发接入处理，不需要商户手填；与 NOWPayments 后台开关是不同配置。
# 付款后返回 Folune 的网站地址。
PAYMENT_APP_ORIGIN=
# NOWPayments 能访问的 API 公网地址，用于付款通知与对账。
PAYMENT_API_ORIGIN=
# 受限支付数据库身份；不是 NOWPayments Key，也不能填普通用户或 service_role token。
PAYMENT_DB_JWT=
# 定时对账服务的通行密钥，由开发生成。
PAYMENT_RECONCILE_SECRET=
# Chat 向 API 报告积分消耗的通行密钥；两服务保持一致，由开发生成。
BILLING_USAGE_SECRET=
# 可选：Folune 支付管理员用户 ID；空值表示无人可使用管理界面。
PAYMENT_ADMIN_IDS=
# 迁移/记账就绪后由开发启用；不能通过关闭它抹掉已有购买权益。
BILLING_LEDGER_ENABLED=false
# 新订单开关；关闭时仍需处理已付款订单、回调与退款。
PAYMENT_CHECKOUT_ENABLED=false
