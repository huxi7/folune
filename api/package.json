{
  "name": "@folune/api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch --clear-screen=false src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test --isolate",
    "payment:check": "bun --env-file=.env ../scripts/check-nowpayments.ts",
    "typecheck": "tsc --noEmit --allowJs false",
    "payment:reconcile": "bun --env-file=.env ../scripts/reconcile-payments.ts",
    "payment:watch": "bun --env-file=.env ../scripts/reconcile-payments.ts --local --watch",
    "payment:gateway": "bun --env-file=.env ../scripts/payment-dev-gateway.ts",
    "payment:test:db": "python3 test/payment-postgres.py",
    "payment:test:http": "python3 test/payment-postgres.py --http"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.12.28",
    "lossless-json": "4.3.0",
    "zod": "^4.4.3"
  }
}
