# [INPUT]: 依赖本地 Supabase Auth 项目与 DeepSeek 服务凭据
# [OUTPUT]: 提供 chat 服务启动、鉴权、CORS 与模型预算所需的无真实密钥变量模板
# [POS]: chat 工程环境契约，只供服务端复制使用，禁止进入 app 前端构建环境
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

PORT=10002
NODE_ENV=development
SYSTEM_NAME=SuperNote Chat
ALLOWED_ORIGINS=http://localhost:10000,http://127.0.0.1:10000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# 唯一允许的模型；其他值会在启动时 fail-fast。
DEFAULT_MODEL=deepseek/deepseek-v4-flash
MAX_STEPS=50
MAX_OUTPUT_TOKENS=393216
